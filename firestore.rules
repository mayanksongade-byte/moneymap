rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Transactions: a user can only read/write their OWN transactions
    match /transactions/{transactionId} {
      // Allow create only if the incoming doc's userId matches the logged-in user
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.userId;

      // Allow read/update/delete only if the EXISTING doc belongs to the logged-in user
      allow read, update, delete: if request.auth != null
                    && request.auth.uid == resource.data.userId;
    }

    // Budgets: one doc per user, doc ID == user's UID
    match /budgets/{userId} {
      allow read, write: if request.auth != null
                    && request.auth.uid == userId;
    }

    // Categories: a user can only manage their own custom categories
    match /categories/{categoryId} {
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.userId;

      allow read, update, delete: if request.auth != null
                    && request.auth.uid == resource.data.userId;
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
